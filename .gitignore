# Upstream code is fetched by tools/fetch_upstream.py at pinned commits
third_party/

# Data, caches, runs and checkpoints never go in git (use Kaggle Datasets)
data_store/
teacher_cache/
runs/
outputs/
*.pt
*.pth
*.npy
*.npz

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Code zip for Kaggle upload (tools/make_code_zip.py)
dist/

# Research documents (Word/PDF reports, not tracked in git)
docs/

# Code version stamp written by `push-code --stamp` / tools/make_code_zip.py
CODE_STAMP.json
